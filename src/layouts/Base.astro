---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
const { title, description = "Quiet houses in the Alps and the North. A concept brand and website.", over = false, bare = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — Stillhaus` : "Stillhaus — Quiet houses in the Alps and the North"}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#1c2621" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>if(!matchMedia("(prefers-reduced-motion: reduce)").matches)document.documentElement.classList.add("js-motion");</script>
  </head>
  <body>
    <div class="spec-bar">Concept project<span class="long"> — Stillhaus is a fictional brand; houses, prices and copy are invented. Photos: Unsplash.</span><span class="short"> — fictional brand</span></div>
    {!bare && <Header over={over} />}
    <main id="main"><slot /></main>
    <Footer bare={bare} />
    <script>import "../scripts/motion.ts";</script>
  </body>
</html>
<style is:global>
  .spec-bar { background: var(--night); color: var(--fog); font-family: var(--f-display); font-stretch: 105%; font-size: 12px; letter-spacing: .04em;
    text-align: center; height: 30px; line-height: 30px; padding: 0 var(--gutter); white-space: nowrap; overflow: hidden; position: relative; z-index: 70; }
  .spec-bar .short { display: none; }
  @media (max-width: 760px) { .spec-bar .long { display: none; } .spec-bar .short { display: inline; } }
</style>
