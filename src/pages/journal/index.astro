---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { photo } from "../../data/photos";
const base = import.meta.env.BASE_URL;
const stories = (await getCollection("journal")).sort((a, b) => b.data.date.localeCompare(a.data.date));
---
<Base title="Journal" description="Rituals, routes and seasons from the Stillhaus houses.">
  <section class="wrap jh">
    <p class="label" data-fade data-now>Journal</p>
    <h1 data-lines data-now>Rituals, routes, seasons</h1>
  </section>
  <section class="wrap jl">
    {stories.map((s, i) => (
      <a class="row" href={`${base}journal/${s.id}/`} data-cursor="Read">
        <div class="frame"><Image quality={70} src={photo(s.data.cover)} alt="" widths={[600, 1000]} sizes="(max-width: 800px) 92vw, 45vw" loading={i === 0 ? "eager" : "lazy"} /></div>
        <div><p class="label">{s.data.kicker} · {s.data.minutes} min</p><h2>{s.data.title}</h2><p class="lede muted">{s.data.dek}</p><span class="ulink">Read</span></div>
      </a>
    ))}
  </section>
</Base>
<style>
  .jh { padding-top: clamp(56px, 8vw, 110px); padding-bottom: 40px; } .jh .label { color: var(--ember); } .jh h1 { margin-top: 12px; }
  .jl { display: grid; gap: 56px; padding-bottom: clamp(80px, 10vw, 140px); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: center; text-decoration: none; border-top: 2px solid var(--pine); padding-top: 36px; }
  .row .frame { aspect-ratio: 3 / 2; } .row :global(img) { transition: transform 1.4s var(--ease-out); } .row:hover :global(img) { transform: scale(1.05); }
  .row .label { color: var(--ember); } .row h2 { margin: 10px 0 14px; } .row .lede { margin: 0 0 20px; }
  @media (max-width: 800px) { .row { grid-template-columns: 1fr; } }
</style>
