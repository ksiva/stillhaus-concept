---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import HouseCard from "../components/HouseCard.astro";
import { houses } from "../data/houses";
import { ads } from "../data/ads";
import { photo } from "../data/photos";
const base = import.meta.env.BASE_URL;
const colours = [
  { name: "Pine", hex: "#1C2621", role: "Ground for dark sections, text on light. The colour of the forest at four in the afternoon.", ink: "#EDEDE7" },
  { name: "Snow", hex: "#EDEDE7", role: "Light ground. Never pure white.", ink: "#1C2621" },
  { name: "Ember", hex: "#A64F20", role: "Actions on light grounds.", ink: "#EDEDE7" },
  { name: "Ember light", hex: "#E0743C", role: "Actions and accents on Pine.", ink: "#1C2621" },
  { name: "Fog", hex: "#D6D8D0", role: "Panels, image placeholders, hover rows.", ink: "#1C2621" },
  { name: "Lake", hex: "#2E4A57", role: "Maps and the occasional cold band.", ink: "#EDEDE7" },
];
const templates = [
  { href: base, label: "Home", note: "A window that opens on scroll, a pinned strip of houses, rituals, journal." },
  { href: `${base}houses/`, label: "Index", note: "Data table with hover previews and ritual filters; cards on phones." },
  { href: `${base}houses/nattlys/`, label: "House", note: "Full-bleed arrival, fact bar, a day in the house, dates." },
  { href: `${base}journal/lake-sauna-for-beginners/`, label: "Editorial", note: "Long read with a house to book at the end." },
  { href: `${base}offers/the-still-week/`, label: "Landing", note: "Paid-traffic page: one offer, scroll-told steps, four houses." },
  { href: `${base}email/`, label: "Email", note: "600 px table template for the letter." },
];
const display = ads.filter((a) => a.kind === "display");
const stills = ads.filter((a) => a.kind !== "display");
---
<Base title="Brand book" description="The Stillhaus identity: logo, type, colour, photography, voice, templates and campaign assets.">
  <section class="bh dark">
    <div class="wrap">
      <p class="label" data-fade data-now>Brand book · concept</p>
      <h1 data-lines data-now>Loud type, <span class="serif-it">quiet</span> places.</h1>
      <p class="lede" data-fade data-now>Stillhaus collects small houses in the mountains and the far north. The identity sets a wide, heavy grotesk against a soft reading serif: the cabin and the book you read in it.</p>
    </div>
  </section>

  <section class="sec wrap">
    <h2 class="sh">Logo</h2>
    <div class="logos">
      <div class="lg dk"><Logo size={56} /></div>
      <div class="lg lt"><Logo size={56} /></div>
      <div class="lg em"><Logo size={56} /></div>
      <div class="lg mk"><Logo size={130} withWord={false} /></div>
    </div>
    <p class="note">A roofline reflected in still water, drawn on a square grid with a 2 px stroke. The wordmark is Archivo at its widest, tracked open. Clear space: the height of the roof on every side. Minimum 20 px for the mark.</p>
  </section>

  <section class="sec wrap">
    <h2 class="sh">Typography</h2>
    <div class="type">
      <div class="spec a"><p class="aa">Aa</p><p class="fn">Archivo, width 125, 700–800</p><p class="muted">Headlines, labels, prices. Always uppercase, tight leading. SIL OFL.</p><p class="smp">Haus Lärche</p></div>
      <div class="spec b"><p class="aa">Aa</p><p class="fn">Newsreader, optical sizes</p><p class="muted">Reading text and italics for places and asides. SIL OFL.</p><p class="smp2">A larch-wood farmhouse facing the Odle peaks, <em>ten rooms and one long table.</em></p></div>
    </div>
  </section>

  <section class="sec wrap">
    <h2 class="sh">Colour</h2>
    <div class="sw">{colours.map((c) => <div class="swatch" style={`background:${c.hex};color:${c.ink}`}><p class="cn">{c.name}</p><p class="hx">{c.hex}</p><p class="cr">{c.role}</p></div>)}</div>
    <p class="note">Two embers, measured separately: the dark one carries light text on Snow, the light one sits on Pine with Pine text. Every text pair passes WCAG AA.</p>
  </section>

  <section class="sec wrap">
    <h2 class="sh">Photography</h2>
    <div class="photos">{[60, 29, 88, 76].map((n) => <div class="frame"><Image quality={70} src={photo(n)} alt="" widths={[500, 800]} sizes="(max-width: 800px) 46vw, 24vw" /></div>)}</div>
    <ul class="rules">
      <li><strong>Low sun, long shadows.</strong> Blue hour, first light, firelight. Never midday glare.</li>
      <li><strong>Through a window.</strong> Show the view from inside; warmth in the foreground, cold beyond.</li>
      <li><strong>Wood, wool, steam.</strong> One tactile detail per house: a stove, a sauna bench, a blanket.</li>
      <li><strong>Empty, not abandoned.</strong> Rooms are ready for someone; people appear small or not at all.</li>
    </ul>
  </section>

  <section class="sec wrap">
    <h2 class="sh">Voice</h2>
    <div class="voice">
      <div><p class="ok">We say</p><p class="v">"We knock when the aurora comes out."</p></div>
      <div><p class="no">Not</p><p class="v x">"Experience the magic of the Northern Lights in luxury."</p></div>
      <div><p class="ok">We say</p><p class="v">"A stove in every room, lit by five."</p></div>
      <div><p class="no">Not</p><p class="v x">"Cosy up in our hygge-inspired rustic-chic suites."</p></div>
    </div>
    <p class="note">Plain, exact, a little dry. Times, distances, what happens. No borrowed words for cosiness.</p>
  </section>

  <section class="sec wrap">
    <h2 class="sh">Components</h2>
    <div class="comp">
      <div class="btns"><a class="btn" href={`${base}houses/nattlys/#dates`}>Find dates <span class="arr">→</span></a><a class="btn line" href={`${base}houses/?ritual=Sauna`}>Filter</a><a class="ulink" href={`${base}houses/`}>All 7 houses</a></div>
      <div class="card"><HouseCard house={houses[0]} /></div>
    </div>
  </section>

  <section class="sec wrap">
    <h2 class="sh">Templates</h2>
    <ul class="tpl">{templates.map((t) => <li><a href={t.href}><span class="tl">{t.label}</span><span class="tn">{t.note}</span><span class="arr">→</span></a></li>)}</ul>
    <p class="note">Houses and stories are content collections: one data entry per house, one Markdown file per story. The same fields map onto Webflow CMS.</p>
  </section>

  <section class="sec wrap" id="campaign">
    <h2 class="sh">Campaign</h2>
    <p class="lede">"The Still Week": one offer told the same way in feed, story, display and email, landing on one page.</p>
    <h3 class="sub">Paid social and email</h3>
    <div class="stills">{stills.map((a) => <figure><img src={`${base}campaign/${a.id}.jpg`} alt={a.label} loading="lazy" width={a.w} height={a.h} /><figcaption>{a.label}</figcaption></figure>)}</div>
    <h3 class="sub">Display (live HTML5, animated)</h3>
    <div class="banners">{display.map((a) => <figure><iframe src={`${base}ads/${a.id}/`} width={a.w} height={a.h} title={a.label} loading="lazy" scrolling="no"></iframe><figcaption>{a.label}</figcaption></figure>)}</div>
    <p class="note">Landing page: <a class="ulink" href={`${base}offers/the-still-week/`}>The Still Week</a> · Email: <a class="ulink" href={`${base}email/`}>Letters from the houses</a></p>
  </section>
</Base>

<style>
  .bh { padding: clamp(80px, 10vw, 150px) 0 clamp(64px, 8vw, 110px); } .bh .label { color: var(--ember-lt); } .bh h1 { margin: 14px 0 28px; max-width: 13ch; }
  .sec { padding-top: clamp(56px, 7vw, 104px); }
  .sh { font-size: 13px; font-stretch: 112%; letter-spacing: .16em; border-top: 2px solid var(--pine); padding-top: 14px; margin-bottom: 30px; }
  .note { color: var(--ink-2); max-width: 70ch; margin: 22px 0 0; }
  .logos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; } .lg { aspect-ratio: 4 / 3; display: grid; place-items: center; } .lg :global(.word) { font-size: 22px; }
  .dk { background: var(--pine); color: var(--snow); } .lt { background: #fff; color: var(--pine); box-shadow: inset 0 0 0 1px var(--line); } .em { background: var(--ember); color: var(--snow); } .mk { background: var(--fog); color: var(--pine); }
  .type { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; } .spec { padding: 32px; background: #fff; }
  .aa { font-size: 150px; line-height: .9; margin: 0; } .a .aa, .a .smp { font-family: var(--f-display); font-stretch: 125%; font-weight: 800; } .b .aa { font-family: var(--f-serif); }
  .fn { font-family: var(--f-display); font-stretch: 112%; font-weight: 600; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; margin: 18px 0 6px; }
  .smp { font-size: 44px; text-transform: uppercase; margin: 22px 0 0; line-height: 1; } .smp2 { font-size: 24px; margin: 22px 0 0; line-height: 1.35; }
  .sw { display: grid; grid-template-columns: repeat(6, 1fr); gap: 8px; } .swatch { aspect-ratio: 3 / 4; padding: 16px; display: flex; flex-direction: column; box-shadow: inset 0 0 0 1px var(--line); }
  .cn { font-family: var(--f-display); font-stretch: 125%; font-weight: 700; text-transform: uppercase; font-size: 17px; margin: 0; } .hx { margin: 4px 0 auto; font-size: 14px; } .cr { font-size: 14px; line-height: 1.35; margin: 0; }
  .photos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; } .photos .frame { aspect-ratio: 3 / 4; }
  .rules { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px 40px; } .rules li { border-top: 1px solid var(--line); padding-top: 12px; }
  .voice { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; } .voice > div { background: #fff; padding: 24px 28px; }
  .ok, .no { font-family: var(--f-display); font-stretch: 112%; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; margin: 0 0 8px; } .ok { color: var(--moss); } .no { color: var(--ember); }
  .v { font-size: 26px; line-height: 1.25; margin: 0; } .v.x { text-decoration: line-through; text-decoration-thickness: 1px; color: var(--ink-3); }
  .comp { display: grid; grid-template-columns: 1fr 340px; gap: 40px; align-items: start; } .btns { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .tpl { list-style: none; padding: 0; margin: 0; border-top: 2px solid var(--pine); }
  .tpl a { display: grid; grid-template-columns: 200px 1fr auto; gap: 20px; padding: 18px 0; border-bottom: 1px solid var(--line); text-decoration: none; align-items: baseline; transition: padding .6s var(--ease-out); }
  .tpl a:hover { padding-left: 16px; color: var(--ember); }
  .tl { font-family: var(--f-display); font-stretch: 125%; font-weight: 700; text-transform: uppercase; font-size: 26px; } .tn { color: var(--ink-2); font-style: italic; }
  .sub { font-family: var(--f-display); font-size: 15px; letter-spacing: .1em; margin: 40px 0 16px; }
  .stills { display: grid; grid-template-columns: 1fr 1fr .62fr 1fr; gap: 16px; align-items: start; } .stills img { width: 100%; height: auto; }
  figure { margin: 0; } figcaption { font-size: 14px; color: var(--ink-3); margin-top: 8px; font-style: italic; }
  .banners { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; } .banners iframe { border: 0; display: block; max-width: 100%; }
  #campaign { padding-bottom: clamp(80px, 10vw, 140px); }
  @media (max-width: 900px) {
    .photos, .sw, .stills { grid-template-columns: 1fr 1fr; } .logos, .type, .voice, .rules, .comp { grid-template-columns: 1fr; } .lg { min-width: 0; overflow: hidden; }
    .tpl a { grid-template-columns: 1fr auto; } .tn { grid-row: 2; }
    .banners figure:has(iframe[width="728"]) { display: none; }
  }
</style>
