---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Offers" description="Current Stillhaus offers.">
  <section class="wrap o">
    <p class="label">Offers</p>
    <h1>This winter</h1>
    <a class="card dark" href={`${base}offers/the-still-week/`}><span class="t">The Still Week</span><span class="muted">Seven nights, pay for six · January to March · sauna every evening</span><span class="btn">See the offer <span class="arr">→</span></span></a>
  </section>
</Base>
<style>
  .o { padding-top: clamp(56px, 8vw, 110px); padding-bottom: clamp(80px, 10vw, 140px); } .o .label { color: var(--ember); } .o h1 { margin: 12px 0 40px; }
  .card { display: grid; gap: 14px; justify-items: start; text-decoration: none; padding: 40px; }
  .t { font-family: var(--f-display); font-stretch: 125%; font-weight: 700; text-transform: uppercase; font-size: clamp(30px, 3.6vw, 56px); line-height: 1; }
</style>
