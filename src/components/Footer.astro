---
import Logo from "./Logo.astro";
const base = import.meta.env.BASE_URL;
const { bare = false } = Astro.props;
---
<footer class="ft dark">
  {!bare && (
    <div class="wrap letter">
      <p class="label">Letters from the houses</p>
      <h2>Snow reports, <span class="serif-it">sauna notes,</span> and the odd free night.</h2>
      <form onsubmit="event.preventDefault(); this.classList.add('done')">
        <label class="sr-only" for="ft-email">Email address</label>
        <input id="ft-email" type="email" required placeholder="you@example.com" autocomplete="email" />
        <button class="btn" type="submit">Sign up <span class="arr">→</span></button>
        <p class="ok">Thank you. (Concept site: nothing was sent.)</p>
      </form>
    </div>
  )}
  <div class="wrap base-row">
    <Logo size={34} />
    <ul>
      <li><a href={`${base}houses/`}>Houses</a></li>
      <li><a href={`${base}journal/lake-sauna-for-beginners/`}>Journal</a></li>
      <li><a href={`${base}offers/the-still-week/`}>The Still Week</a></li>
      <li><a href={`${base}brand/`}>Brand book</a></li>
      <li><a href={`${base}brand/#campaign`}>Campaign</a></li>
      <li><a href={`${base}credits/`}>Credits</a></li>
    </ul>
  </div>
  <p class="wrap legal">Concept / spec work. Stillhaus and every house shown are fictional. Photography from Unsplash under the Unsplash License (sources on the credits page). Type: Archivo and Newsreader, SIL Open Font License.</p>
  <div class="giant" aria-hidden="true">Stillhaus</div>
</footer>
<style>
  .ft { padding-top: clamp(80px, 10vw, 140px); overflow: hidden; }
  .letter h2 { max-width: 18ch; margin: 18px 0 36px; }
  .letter .label { color: var(--ember-lt); }
  form { display: flex; gap: 12px; flex-wrap: wrap; max-width: 640px; }
  input { flex: 1 1 260px; background: transparent; border: 0; border-bottom: 1px solid var(--line-dk); padding: 14px 0; font-size: 19px; color: var(--snow); }
  input::placeholder { color: var(--on-dark-2); }
  .ok { display: none; width: 100%; color: var(--ember-lt); margin: 6px 0 0; } form:global(.done) .ok { display: block; }
  .base-row { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; margin-top: 96px; padding-top: 28px; border-top: 1px solid var(--line-dk); }
  .base-row ul { display: flex; flex-wrap: wrap; gap: 8px 28px; list-style: none; padding: 0; margin: 0; }
  .base-row a { text-decoration: none; font-family: var(--f-display); font-stretch: 112%; font-size: 12.5px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; }
  .base-row a:hover { color: var(--ember-lt); }
  .legal { font-size: 14px; color: var(--on-dark-2); margin-top: 22px; }
  .giant { font-family: var(--f-display); font-weight: 800; font-stretch: 125%; text-transform: uppercase; font-size: 15.2vw; line-height: .78; letter-spacing: -.03em; color: var(--pine-2); text-align: center; margin-top: 40px; white-space: nowrap; transform: translateY(8%); }
</style>
