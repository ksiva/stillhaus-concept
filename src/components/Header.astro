---
import Logo from "./Logo.astro";
const { over = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
  { href: `${base}houses/`, label: "Houses" },
  { href: `${base}journal/lake-sauna-for-beginners/`, label: "Journal", match: `${base}journal/` },
  { href: `${base}offers/the-still-week/`, label: "The Still Week", match: `${base}offers/` },
  { href: `${base}brand/`, label: "Brand book" },
];
---
<header class:list={["site-header", { over }]}>
  <div class="wrap bar">
    <a href={base} class="home" aria-label="Stillhaus home"><Logo /></a>
    <nav aria-label="Main"><ul>{nav.map((n) => <li><a href={n.href} aria-current={path.startsWith(n.match ?? n.href) ? "page" : undefined}>{n.label}</a></li>)}</ul></nav>
    <a class="btn cta on-dark" href={`${base}houses/`}>Find dates <span class="arr">→</span></a>
    <button class="menu-btn" data-menu-toggle aria-expanded="false" aria-controls="mnav">Menu</button>
  </div>
  <div class="mnav" id="mnav">
    <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
    <a class="btn on-dark" href={`${base}houses/`}>Find dates <span class="arr">→</span></a>
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--pine); color: var(--snow); transition: transform .6s var(--ease), background .4s; }
  .over { position: fixed; left: 0; right: 0; top: 30px; background: transparent; }
  .over.is-solid { top: 0; background: rgba(28, 38, 33, .9); backdrop-filter: blur(12px); }
  .site-header.is-hidden { transform: translateY(-110%); }
  .bar { display: flex; align-items: center; gap: 36px; height: 76px; }
  .home { text-decoration: none; margin-right: auto; }
  nav ul { display: flex; gap: 32px; list-style: none; padding: 0; margin: 0; }
  nav a { white-space: nowrap; text-decoration: none; font-family: var(--f-display); font-stretch: 112%; font-size: 12.5px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; position: relative; display: inline-block; overflow: hidden; padding: 4px 0; }
  nav a::before { content: ""; position: absolute; left: 0; bottom: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--ember-lt); transform: scale(0); transition: transform .4s var(--ease-out); }
  nav a[aria-current="page"]::before { transform: scale(1); left: -14px; bottom: 8px; }
  nav a:hover { color: var(--ember-lt); }
  .cta { padding: 13px 18px; }
  .menu-btn { display: none; background: none; border: 1px solid var(--line-dk); color: inherit; padding: 9px 14px; font-family: var(--f-display); font-stretch: 112%; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 600; cursor: pointer; }
  .mnav { display: none; }
  @media (max-width: 1100px) {
    nav, .cta { display: none; } .menu-btn { display: block; } .bar { height: 62px; }
    .mnav { display: flex; flex-direction: column; justify-content: space-between; position: fixed; inset: 0; padding: 100px var(--gutter) 40px; background: var(--pine); color: var(--snow);
      clip-path: inset(0 0 100% 0); transition: clip-path .8s var(--ease); z-index: -1; }
    .mnav ul { list-style: none; padding: 0; margin: 0; }
    .mnav a:not(.btn) { font-family: var(--f-display); font-stretch: 125%; font-weight: 700; text-transform: uppercase; font-size: 34px; letter-spacing: -.01em; text-decoration: none; line-height: 1.35; }
    .mnav .btn { align-self: flex-start; }
    :global(body.menu-open) .mnav { clip-path: inset(0 0 0 0); }
  }
</style>
